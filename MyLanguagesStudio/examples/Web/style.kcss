body { font-family: system-ui, sans-serif; background: #f3f6fb; margin: 0; min-height: 100vh; display: grid; place-items: center; }
.card { background: white; padding: 2rem; border-radius: 18px; box-shadow: 0 12px 35px #0001; max-width: 520px; }
button { border: 0; border-radius: 9px; padding: .8rem 1.2rem; background: #2563eb; color: white; cursor: pointer; }