{
  "name": "seol-code",
  "displayName": "설이코드 (SEOL CODE)",
  "description": "한국어 프로그래밍 언어 설이코드 지원 - Windows 독립 실행형",
  "version": "0.5.0",
  "publisher": "calbalam123",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "seol",
    "korean",
    "language",
    "설이코드"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:seol",
    "onCommand:seol.runFile",
    "onCommand:seol.compileBot",
    "onCommand:seol.openOutput"
  ],
  "contributes": {
    "languages": [
      {
        "id": "seol",
        "aliases": [
          "설이코드",
          "Seol Code",
          "seol"
        ],
        "extensions": [
          ".seol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "seol",
        "scopeName": "source.seol",
        "path": "./syntaxes/seol.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "seol.runFile",
        "title": "설이코드: 현재 파일 실행",
        "category": "설이코드",
        "icon": "$(play)"
      },
      {
        "command": "seol.compileBot",
        "title": "설이코드: 카카오봇 연결 파일 만들기",
        "category": "설이코드",
        "icon": "$(file-code)"
      },
      {
        "command": "seol.openOutput",
        "title": "설이코드: 실행 터미널 열기",
        "category": "설이코드"
      }
    ],
    "keybindings": [
      {
        "command": "seol.runFile",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == seol"
      }
    ],
    "configuration": {
      "title": "설이코드",
      "properties": {
        "seol.standaloneRunner": {
          "type": "string",
          "default": "",
          "description": "고급 설정: 포함된 설이코드 실행기를 대체할 실행 파일 경로"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "seol.runFile",
          "when": "resourceExtname == .seol",
          "group": "navigation@1"
        },
        {
          "command": "seol.compileBot",
          "when": "resourceExtname == .seol",
          "group": "navigation@2"
        }
      ]
    }
  }
}
