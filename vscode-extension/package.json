{
  "name": "seol-code",
  "displayName": "설이코드 (SEOL CODE)",
  "description": "한국어 프로그래밍 언어 설이코드 지원",
  "version": "0.3.0",
  "publisher": "calbalam123",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "seol",
    "korean",
    "language",
    "설이코드"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:seol",
    "onCommand:seol.runFile",
    "onCommand:seol.openOutput"
  ],
  "contributes": {
    "languages": [
      {
        "id": "seol",
        "aliases": [
          "설이코드",
          "Seol Code",
          "seol"
        ],
        "extensions": [
          ".seol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "seol",
        "scopeName": "source.seol",
        "path": "./syntaxes/seol.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "seol.runFile",
        "title": "설이코드: 현재 파일 실행",
        "category": "설이코드",
        "icon": "$(play)"
      },
      {
        "command": "seol.openOutput",
        "title": "설이코드: 실행 터미널 열기",
        "category": "설이코드"
      }
    ],
    "keybindings": [
      {
        "command": "seol.runFile",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == seol"
      }
    ],
    "configuration": {
      "title": "설이코드",
      "properties": {
        "seol.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "설이코드 실행에 사용할 Python 명령. Windows Python Launcher는 py -3으로 지정할 수 있습니다."
        },
        "seol.runnerPath": {
          "type": "string",
          "default": "",
          "description": "seol.py 파일 경로. 비워두면 현재 작업공간 최상위 폴더의 seol.py를 사용합니다."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "seol.runFile",
          "when": "resourceExtname == .seol",
          "group": "navigation@1"
        }
      ]
    }
  }
}
