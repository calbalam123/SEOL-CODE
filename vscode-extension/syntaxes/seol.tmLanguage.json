{
  "scopeName": "source.seol",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.number-sign.seol", "match": "#.*$" }]
    },
    "strings": {
      "name": "string.quoted.double.seol",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.seol", "match": "\\\\." }]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.seol", "match": "\\b(만약|아니면|반복|함수|반환)\\b" },
        { "name": "keyword.operator.logical.seol", "match": "\\b(그리고|또는|아니다)\\b" }
      ]
    },
    "constants": {
      "patterns": [{ "name": "constant.language.seol", "match": "\\b(참|거짓|없음)\\b" }]
    },
    "functions": {
      "patterns": [{ "name": "entity.name.function.seol", "match": "(?<=\\b)(출력|길이|문자열|정수|실수|반올림|절댓값|최댓값|최솟값|합계|추가|포함|제곱근|거듭제곱|평균|중앙값|백분율|무작위|현재시간|오늘날짜|문자바꾸기|목록추가|목록정렬|JSON문자열|JSON읽기)(?=\\s*\\()" }]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.seol", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }]
    },
    "operators": {
      "patterns": [{ "name": "keyword.operator.seol", "match": "(\\+|\\-|\\*|/|//|%|==|!=|<=|>=|=|<|>)" }]
    }
  }
}