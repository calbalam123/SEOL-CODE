# 설이코드 카카오봇 0.3 - 계좌와 송금
경제시스템(10000)

명령어("!안녕", "안녕하세요! 설이 카카오봇입니다. 😊")
명령어("!도움말", "[ 설이은행 봇 ]\n!계좌 - 계좌 개설 및 정보\n!잔액 - 잔액 확인\n!송금 받는사람 금액 - 송금\n!내정보 - 사용자 정보")

명령어("!계좌"):
    계좌확인()

명령어("!잔액"):
    잔액확인()

명령어("!송금"):
    송금처리()

명령어("!내정보"):
    답장("사용자: " + 보낸사람())
    답장("방 이름: " + 방이름())
