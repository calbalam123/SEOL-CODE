# 설이코드 0.2.0 확장 문법 예제

이름 = "설이"
출력("안녕하세요, " + 이름)

과일 = ["사과", "배", "포도"]
출력("과일 개수:", 길이(과일))

반복 항목 in 과일:
    출력("과일:", 항목)

숫자들 = [10, 20, 30]
추가(숫자들, 40)
출력("합계:", 합계(숫자들))
출력("최댓값:", 최댓값(숫자들))

함수 계산하기(가, 나):
    반환 가 * 나 + 5

결과 = 계산하기(7, 3)
만약 결과 >= 20 그리고 포함(과일, "배"):
    출력("계산 결과:", 결과)
아니면:
    출력("조건에 맞지 않습니다.")
